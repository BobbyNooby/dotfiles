#!/usr/bin/env bash
# Alt+Tab: focus the next window in Hyprland's own focus history, following it to
# whatever workspace it lives on (the screen moves to the window, like the Mac's Cmd+Tab).
#
#   alt-tab          next (most recent first)
#   alt-tab prev     previous
#
# Hyprland keeps focusHistoryID per window: 0 is the focused window, 1 the one before it,
# and so on. Sorting clients by it is the MRU list, so no daemon or state file is needed —
# every call re-reads the live order.
set -euo pipefail

direction=next
[[ "${1:-}" == "prev" ]] && direction=prev

# Window addresses, most recently focused first. Skip unmapped (closing) windows.
mapfile -t windows < <(
    hyprctl clients -j |
        jq -r '[.[] | select(.mapped)] | sort_by(.focusHistoryID) | .[].address'
)

count=${#windows[@]}
(( count > 1 )) || exit 0

current=$(hyprctl activewindow -j | jq -r '.address // empty')

index=0
for i in "${!windows[@]}"; do
    [[ "${windows[$i]}" == "$current" ]] && index=$i
done

if [[ $direction == next ]]; then
    target=$(( (index + 1) % count ))
else
    target=$(( (index - 1 + count) % count ))
fi

hyprctl dispatch "hl.dsp.focus({ window = \"address:${windows[$target]}\" })" >/dev/null

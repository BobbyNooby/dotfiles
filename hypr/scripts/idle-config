#!/bin/sh
# Writes ~/.config/hypr/hypridle.conf from the idle settings and restarts hypridle.
# Run by hypridle's service before it starts (a systemd drop-in) and by the shell whenever the
# idle settings change (Settings → Power). Not in git: settings.nix `desktop.idle` holds the
# defaults, ~/.config/desktop/overrides.json what the Settings window changed.
#
#   dim, lock, screenOff, suspend   seconds idle before each (0 = never)
#   suspendPluggedIn                 also suspend when on the charger (false = only on battery)
#   lockOnSleep                      lock before the laptop sleeps (lid, suspend)
#
# `idle-config --no-restart` only writes the file.
PATH="/run/wrappers/bin:/etc/profiles/per-user/$USER/bin:$HOME/.nix-profile/bin:/run/current-system/sw/bin:$PATH"
export PATH

dir="$HOME/.config/desktop"
out="$HOME/.config/hypr/hypridle.conf"
scripts="$HOME/.config/hypr/scripts"

# settings.json's idle, then overrides.json's on top (either file may be missing)
# (cat, not file arguments: jq fails outright when one of its files is missing, which threw
# away settings.json's values whenever overrides.json didn't exist)
idle=$(cat "$dir/settings.json" "$dir/overrides.json" 2>/dev/null | jq -s '
  (map(.idle // {}) | add // {}) as $i
  | { dim: 150, lock: 300, screenOff: 330, suspend: 1800, suspendPluggedIn: true, lockOnSleep: true } + $i
' 2>/dev/null) \
  || idle='{"dim":150,"lock":300,"screenOff":330,"suspend":1800,"suspendPluggedIn":true,"lockOnSleep":true}'
get() { echo "$idle" | jq -r ".$1"; }

# Full paths: hypridle's service has a bare PATH, so the commands it runs must be absolute
bctl=$(command -v brightnessctl); hctl=$(command -v hyprctl); lctl=$(command -v loginctl)
sctl=$(command -v systemctl)

dim=$(get dim); lock=$(get lock); off=$(get screenOff); sus=$(get suspend)
plugged=$(get suspendPluggedIn); onsleep=$(get lockOnSleep)

# On the charger and told not to suspend there: skip (ACAD/AC/ADP1 depending on the laptop)
if [ "$plugged" = true ]; then
    suspend_cmd="$sctl suspend"
else
    suspend_cmd="$(command -v grep) -qx 1 /sys/class/power_supply/A*/online 2>/dev/null || $sctl suspend"
fi

{
    echo "# GENERATED by ~/.config/hypr/scripts/idle-config from the idle settings"
    echo "# (settings.nix desktop.idle + Settings → Power). Edits here are overwritten."
    echo
    echo "general {"
    echo "    lock_cmd = $scripts/lock  # the Eva lock (hyprlock if the shell can't); never two"
    [ "$onsleep" = true ] && echo "    before_sleep_cmd = $lctl lock-session  # lock before suspend"
    echo "    after_sleep_cmd = $hctl dispatch 'hl.dsp.dpms({action = \"on\"})'  # screen back on after resume"
    echo "}"
    if [ "$dim" -gt 0 ] 2>/dev/null; then
        printf '\nlistener {\n    timeout = %s  # dim\n    on-timeout = %s -s set 10\n    on-resume = %s -r\n}\n' "$dim" "$bctl" "$bctl"
    fi
    if [ "$lock" -gt 0 ] 2>/dev/null; then
        printf '\nlistener {\n    timeout = %s  # lock\n    on-timeout = %s lock-session\n}\n' "$lock" "$lctl"
    fi
    if [ "$off" -gt 0 ] 2>/dev/null; then
        printf '\nlistener {\n    timeout = %s  # screen off\n    on-timeout = %s dispatch '"'"'hl.dsp.dpms({action = "off"})'"'"'\n    on-resume = %s dispatch '"'"'hl.dsp.dpms({action = "on"})'"'"'\n}\n' "$off" "$hctl" "$hctl"
    fi
    if [ "$sus" -gt 0 ] 2>/dev/null; then
        printf '\nlistener {\n    timeout = %s  # suspend\n    on-timeout = %s\n}\n' "$sus" "$suspend_cmd"
    fi
} > "$out.tmp" && mv "$out.tmp" "$out"

[ "$1" = "--no-restart" ] || systemctl --user try-restart hypridle.service

#!/bin/sh
# Lock the screen: the Eva lock (Quickshell, dotfiles/quickshell/LockScreen.qml), or hyprlock if
# the shell can't. Used by hypridle (idle, lid/sleep), Super+Escape and the power menu.
#
# Falls back to hyprlock only when the shell isn't running, `qs ipc` hangs (e.g. two shells),
# or the Eva lock is still "unlocked" after ~2 s. ("pending" = asked, Hyprland not done yet:
# that's fine, starting hyprlock then would fight it for the screen.)
# What happened each time: ~/.cache/lock.log
#
# Plain sh with its own PATH: hypridle runs this from a systemd service that has neither bash
# nor your programs on its PATH.
PATH="/run/wrappers/bin:/etc/profiles/per-user/$USER/bin:$HOME/.nix-profile/bin:/run/current-system/sw/bin:$PATH"
export PATH
log() { echo "$(date '+%F %T') $*" >> "$HOME/.cache/lock.log"; }

status() { timeout 1 qs ipc call lock status 2>/dev/null; }

pidof hyprlock >/dev/null && { log "hyprlock already up"; exit 0; }
s=$(status)
case "$s" in locked|pending) log "already $s"; exit 0 ;; esac

if timeout 3 qs ipc call lock lock >/dev/null 2>&1; then
    for i in 1 2 3 4 5 6 7 8; do
        s=$(status)
        case "$s" in locked|pending) log "eva $s after $i checks"; exit 0 ;; esac
        sleep 0.25
    done
    log "eva still '$s' after 2 s: hyprlock"
else
    log "qs ipc failed or hung: hyprlock"
fi
exec hyprlock

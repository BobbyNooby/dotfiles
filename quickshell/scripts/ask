#!/usr/bin/env bash
# The side panel's link to the agents (Super+A). Runs in your config repo so they see this
# machine's notes (CLAUDE.md / AGENTS.md). Every chat starts new; /sessions picks an old one.
#
#   ask hermes <quick|edit> <session-id|new> <message>
#       Prints the answer. "new" starts a session, titles it with your first message, and
#       prints "@@SESSION <id>" last so the panel can carry it on.
#   ask claude <quick|edit> <new|continue> <session-uuid> <message>
#       Streams Claude Code's JSON events (one per line) for the panel to draw as they come.
#       quick: can only read files and search/fetch the web. Nothing else exists for it (no
#              edits, shell, MCP servers or sub-agents), so text on a web page can't make it
#              change anything.
#       edit:  may also edit files (and search), still no shell.
#   ask sessions <hermes|claude>
#       Recent sessions in this folder, newest first: "<id>\t<title>\t<when>" per line.
#   ask undo <git-ref> <file>...
#       Puts those files back as they were at <git-ref> (taken just before an edit-mode
#       message); files that didn't exist then are removed.
set -u
# the repo, from ~/.config/desktop/settings.json (settings.nix): relative paths are under $HOME
repo=$(jq -r '.repo // "nixos-config"' "$HOME/.config/desktop/settings.json" 2>/dev/null || echo nixos-config)
case "$repo" in /*) ;; *) repo="$HOME/${repo#\~/}" ;; esac
cd "$repo" 2>/dev/null || cd "$HOME" # no config repo here: work from home
clean() { grep -v '^⚠'; } # Hermes's own status lines (e.g. its install check)

# Say plainly when an agent isn't installed (the panel shows this as the answer)
need() { command -v "$1" >/dev/null || { echo "$2 isn't installed (\`$1\` not found). $3"; exit 0; }; }

case "$1" in
hermes)
    need hermes "Hermes" "See github.com/NousResearch/hermes-agent."
    mode=$2 sid=$3 msg=$4
    ask=$msg
    [ "$mode" = quick ] && ask="(Answer only: don't change any files or settings.) $msg"
    # The panel's Stop button sends this script TERM. Bash only acts on it between commands,
    # and Hermes would carry on by itself, so run Hermes in the background, wait for it, and
    # pass the TERM on.
    trap 'kill $(jobs -p) 2>/dev/null; exit 143' TERM
    if [ "$sid" != new ]; then
        hermes --resume "$sid" -z "$ask" </dev/null 2>/dev/null | clean &
        wait $!
        exit 0
    fi
    hermes -z "$ask" </dev/null 2>&1 | clean &
    wait $!
    new=$(hermes sessions list --limit 1 2>/dev/null | grep -o 'local-[0-9a-f]*' | head -1)
    if [ -n "$new" ]; then
        hermes sessions rename "$new" "$(printf '%s' "$msg" | tr '\n' ' ' | cut -c1-60)" >/dev/null 2>&1
        echo "@@SESSION $new"
    fi ;;
claude)
    need claude "Claude Code" "See docs.claude.com/claude-code."
    mode=$2 session=$3 sid=$4 msg=$5
    if [ "$mode" = quick ]; then
        # An allow-list, not "everything but": --tools leaves only these built-in tools to
        # call, --allowedTools lets them run unasked, and dontAsk + "--permission-prompts none"
        # refuse whatever else turns up (MCP or plugin tools) instead of waiting for an answer
        # nobody can give. A fetched page that says "run this" has nothing to run it with.
        ro=Read,Glob,Grep,WebSearch,WebFetch
        perms=(--tools "$ro" --allowedTools "$ro" --permission-mode dontAsk --permission-prompts none)
    else
        perms=(--permission-mode acceptEdits --allowedTools WebSearch WebFetch --disallowedTools Bash)
    fi
    if [ "$session" = continue ]; then s=(--resume "$sid"); else s=(--session-id "$sid"); fi
    exec claude -p --output-format stream-json --verbose --include-partial-messages \
        "${s[@]}" "${perms[@]}" -- "$msg" </dev/null 2>&1 ;;
sessions)
    if [ "$2" = hermes ]; then
        # columns: Title  Workspace  Last Active  ID (only this folder's sessions)
        hermes sessions list --limit 15 --workspace "$PWD" 2>/dev/null | clean |
            sed -nE 's/^(.*[^ ]) {2,}[^ ]+ {2,}(.*[^ ]) {2,}(local-[0-9a-f]+) *$/\3\t\1\t\2/p'
    else
        dir="$HOME/.claude/projects/$(pwd | tr '/.' '--')"
        command ls -t "$dir"/*.jsonl 2>/dev/null | head -15 | while read -r f; do
            title=$(jq -r 'select(.type=="user") | .message.content
                | if type=="string" then . else (map(select(.type=="text")|.text)|join(" ")) end
                | select(length > 0)' "$f" 2>/dev/null | head -1 | tr '\n\t' '  ' | cut -c1-60)
            [ -n "$title" ] || continue
            when=$(date -r "$f" '+%a %d %b %H:%M')
            printf '%s\t%s\t%s\n' "$(basename "$f" .jsonl)" "$title" "$when"
        done
    fi ;;
undo)
    ref=$2; shift 2
    for f in "$@"; do
        if git cat-file -e "$ref:$f" 2>/dev/null; then git restore --source="$ref" --worktree -- "$f"
        else rm -f -- "$f"; fi
    done ;;
esac
